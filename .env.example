# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"


# Database connection: use EITHER DATABASE_URL (e.g. for Supabase or any
# hosted Postgres) OR the individual SQL_* variables below (e.g. for Cloud
# SQL / a local Postgres instance) — not both. DATABASE_URL takes priority
# if both are set.
DATABASE_URL=""

# Cloud SQL Connection Environment Variables
SQL_HOST=""
SQL_PORT=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
# Optional: separate credentials used only by `drizzle-kit` for migrations.
# Falls back to SQL_USER / SQL_PASSWORD above if not set.
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Set to "require" (or "true") to enable SSL for the SQL_* connection method,
# e.g. when SQL_HOST points at a hosted provider rather than localhost.
# DATABASE_URL connections auto-detect SSL based on the host.
PGSSLMODE=""

# Required in production. Signs staff/admin login session cookies — use a
# long random value (e.g. `openssl rand -hex 32`). If unset in local
# development, a random value is generated at process start (sessions will
# not survive a server restart).
SESSION_SECRET=""

# SMTP credentials used to send "forgot password" verification codes by real
# email. Works with any standard SMTP provider (Gmail with an app password,
# SendGrid, Mailgun, Amazon SES, etc). If unset, the forgot-password flow
# responds with a clear "email service unavailable" error instead of failing
# silently or leaking the code in the API response.
SMTP_HOST=""
SMTP_PORT=""
# "true" for port 465 (implicit TLS); leave unset/"false" for port 587 (STARTTLS).
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
# Defaults to SMTP_USER if unset.
SMTP_FROM=""

